# Copy to .env.local and set to your server's address.
# For the Render deploy this is the URL shown at the top of the service page.
EXPO_PUBLIC_API_URL=https://callyourshot-api.onrender.com
# Only for real Google sign-in in store/dev builds (see LAUNCH.md). Leave empty for testing.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
