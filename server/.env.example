# Copy to .env (or set these in your host's dashboard). Never commit real values.

# The Odds API key (the-odds-api.com). Only the server uses it.
ODDS_API_KEY=
# Day of the month your Odds API plan renews (UTC). Match your subscription date.
ODDS_API_RESET_DAY=16
# Credits in your Odds API plan per month: 500 on the free tier, 20000 on the $30 plan.
# This is the only setting to change when you upgrade; the scheduler adapts on its own.
ODDS_API_MONTHLY_CREDITS=500
# Credits kept back for grading picks if the month runs hot (10%).
ODDS_API_RESERVE_FRACTION=0.1

# Long random string: the password for the admin page at /admin.
ADMIN_TOKEN=

# Long random string that encrypts winners' prize details. Claims are refused until it's set.
# Never change it once winners have claimed, or their details can't be read.
CLAIMS_KEY=

# stub = test sign-in (works in Expo Go); live = verify real Apple and Google sign-ins.
AUTH_MODE=stub
APPLE_CLIENT_IDS=com.callyourshot.app
# Your Google OAuth client ids (iOS, Android, web), comma separated. Needed for AUTH_MODE=live.
GOOGLE_CLIENT_IDS=
# Date of the current Official Rules; saved with each player's agreement.
TERMS_VERSION=2026-11-16

# stub = fake 5-second ad for development; admob = real rewarded ads with server-side verification.
AD_PROVIDER=stub
# Your AdMob rewarded ad unit ids, comma separated. Callbacks from other units are refused.
ADMOB_AD_UNIT_IDS=
# Videos for points per day (10 points each), only while a player is out of points.
# Per contest: each contest a player joins has its own 5 refills a day.
POINTS_ADS_PER_DAY=5

PORT=8080
DB_PATH=./data/callyourshot.db
APP_TIME_ZONE=America/New_York
